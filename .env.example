# IA principal
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=15
GROQ_COOLDOWN=60

# IA local de fallback
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=30

# Voz
JARVIS_NAME=NEXUS
WAKE_WORD=nexus
WAKE_SOUND_ENABLED=true
WAKE_SOUND_PATH=assets/wake.wav
WAKE_SOUND_FREQUENCY=880
WAKE_SOUND_DURATION_MS=120
WAKE_GRAMMAR_ONLY=true
VOSK_MODEL_PATH=models/vosk-model-small-en-us
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SAMPLE_RATE=16000
COMMAND_MAX_SECONDS=10
COMMAND_CHUNK_MS=30
COMMAND_PRE_ROLL_MS=300
COMMAND_NOISE_CALIBRATION_MS=240
COMMAND_SPEECH_MULTIPLIER=2.2
COMMAND_MIN_RMS=450
COMMAND_SILENCE_MS=650
COMMAND_START_TIMEOUT_MS=5000
WHISPER_HOTWORDS=NEXUS, Spotify, YouTube, Google, WhatsApp, Discord, Gmail, Opera
WHISPER_INITIAL_PROMPT=Comando de voz do assistente NEXUS em português brasileiro. Palavras importantes: NEXUS, Spotify, YouTube, Google, WhatsApp, Discord, Gmail, Opera.

# TTS
TTS_ENABLED=true
TTS_ENGINE=piper
TTS_FALLBACK_ENABLED=true
TTS_VOICE_NAME=pt_BR-jeff-medium
TTS_RATE=175
TTS_VOLUME=1.0
PIPER_DATA_DIR=models/piper
PIPER_MODEL_PATH=models/piper/pt_BR-jeff-medium.onnx
PIPER_LENGTH_SCALE=0.95
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8
PIPER_VOLUME=1.0
HF_HUB_DISABLE_SYMLINKS=1


# NEXUS 6.0 - Web e navegador
WEB_SEARCH_ENGINE=bing
WEB_SEARCH_LIMIT=6
WEB_REQUEST_TIMEOUT=10
BROWSER_HEADLESS=false
BROWSER_CHANNEL=
BROWSER_PROFILE_DIR=data/browser_profile
BROWSER_NAV_TIMEOUT=15000
BROWSER_READ_LIMIT=8000

# Modo
TEXT_ONLY=false

# Caminhos opcionais de aplicativos
SPOTIFY_PATH=C:\Users\Felipe\AppData\Roaming\Spotify\Spotify.exe
OPERA_PATH=C:\Users\Felipe\AppData\Local\Programs\Opera GX\opera.exe

# Painel local
PANEL_ENABLED=true
PANEL_HOST=127.0.0.1
PANEL_PORT=8765

# Links de playlists do Spotify (opcional)
SPOTIFY_PLAYLIST_TREINO=
SPOTIFY_PLAYLIST_CALMA=
SPOTIFY_PLAYLIST_FOCO=

# NEXUS 5.0 - Controle do PC
FILE_SEARCH_LIMIT=30
PROCESS_LIST_LIMIT=25


# NEXUS FINAL - Produtividade
GOOGLE_ENABLED=false
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json
GOOGLE_GMAIL_TOKEN_FILE=data/google_gmail_token.json
GOOGLE_TASKS_TOKEN_FILE=data/google_tasks_token.json
GOOGLE_TIMEZONE=America/Sao_Paulo

# Gmail / Google Tasks / lembretes
GMAIL_MAX_RESULTS=10
REMINDER_POLL_SECONDS=2
REMINDER_SPEAK=true

# Visão com Groq
VISION_ENABLED=true
VISION_MODEL=qwen/qwen3.6-27b
VISION_MAX_IMAGE_MB=20

# API local para celular/outros dispositivos
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8766
API_TOKEN=

# Smart Home - desativado por padrão
SMART_HOME_PROVIDER=none
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
ESP32_BASE_URL=
